/* REXX */

parse upper arg argline
argline = strip(argline)

cmdText = ''
execdsn = ''
inargs = ''
outdsn = ''

cmdPos = pos('CMD(', argline)
indsPos = pos('INDS(', argline)
inargsPos = pos('INARGS(', argline)
outdsPos = pos('OUTDS(', argline)

if cmdPos > 0 then
  cmdText = strip(substr(argline, cmdPos + 4, pos(')', argline, cmdPos) - cmdPos - 4))

if indsPos > 0 then
  execdsn = strip(substr(argline, indsPos + 5, pos(')', argline, indsPos) - indsPos - 5))

if inargsPos > 0 then
  inargs = strip(substr(argline, inargsPos + 7, pos(')', argline, inargsPos) - inargsPos - 7))

if outdsPos > 0 then
  outdsn = strip(substr(argline, outdsPos + 6, pos(')', argline, outdsPos) - outdsPos - 6))

if outdsn = '' | (cmdText = '' & execdsn = '') | (cmdText <> '' & execdsn <> '') then do
  say 'Usage: EX ''userid.rexx.write'' ''CMD(command text) OUTDS(output.dataset)'''
  say '   or: EX ''userid.rexx.write'' ''INDS(exec.dataset) [INARGS(argument text)] OUTDS(output.dataset)'''
  say 'Examples:'
  say "  EX 'userid.rexx.write' 'CMD(LISTUSER IBMUSER) OUTDS(userid.out.lu)'"
  say "  EX 'userid.rexx.write' 'CMD(RLIST FACILITY BPX.SERVER ALL) OUTDS(userid.out.rl)'"
  say "  EX 'userid.rexx.write' 'INDS(userid.rexx.myexec) OUTDS(userid.out.exec)'"
  say "  EX 'userid.rexx.write' 'INDS(userid.rexx.myexec) INARGS(USER1 TEST) OUTDS(userid.out.exec)'"
  exit 8
end

if cmdText <> '' & inargs <> '' then do
  say 'INARGS() is only valid with INDS()'
  exit 8
end

/* Allocate a new sequential output data set */
address tso
"ALLOC FI(OUTDD) DA('"outdsn"') NEW CATALOG" ,
  "SPACE(20,10) TRACKS" ,
  "LRECL(133) RECFM(F B) DSORG(PS)"

if rc <> 0 then do
  say 'Allocation failed for' outdsn 'RC='rc
  exit rc
end

/* Capture terminal output generated by the called exec or command */
drop captured.
captured.0 = 0

traprc = outtrap('captured.')
if execdsn <> '' then do
  if inargs <> '' then
    "EX '"execdsn"' '"inargs"'"
  else
    "EX '"execdsn"'"
end
else
  cmdText
execrc = rc
traprc = outtrap('OFF')

/* Write captured lines to the output data set */
if captured.0 > 0 then do
  "EXECIO" captured.0 "DISKW OUTDD (STEM captured. FINIS"
  writerc = rc
end
else do
  writerc = 0
end

"FREE FI(OUTDD)"

say captured.0 'lines written to' outdsn

if execrc <> 0 then do
  if execdsn <> '' then
    say 'Called exec ended with RC='execrc
  else
    say 'Command ended with RC='execrc
end

exit execrc
